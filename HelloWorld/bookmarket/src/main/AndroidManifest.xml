<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="BookMarket" android:theme="@style/Theme.BookMarket" android:usesCleartextTraffic="true">
        <activity android:name=".BoardActivity" android:exported="false" android:label="고객문의" android:theme="@style/Theme.BookMarket.ActionBar" />
        <activity android:name=".BoardDetailActivity" android:exported="false" android:label="상세보기" android:theme="@style/Theme.BookMarket.ActionBar" />
        <activity android:name=".BoardWriteActivity" android:exported="false" android:label="글쓰기" android:theme="@style/Theme.BookMarket.ActionBar" />
        <meta-data android:name="com.google.android.geo.API_KEY" android:value="${MAPS_API_KEY}" />
        <activity android:name=".MarketInfoActivity" android:exported="false" android:label="마켓정보" android:theme="@style/Theme.BookMarket.ActionBar" />
        <activity android:name=".MemoActivity" android:exported="false" android:label="메모장" android:theme="@style/Theme.BookMarket.ActionBar" />
        <activity android:name=".MyPageActivity" android:exported="false" android:label="나의 페이지" android:theme="@style/Theme.BookMarket.ActionBar" />
        <activity android:name=".OrderActivity" android:exported="false" android:label="주문서" android:theme="@style/Theme.BookMarket.ActionBar" />
        <activity android:name=".ShippingActivity" android:exported="false" android:label="배송정보" android:theme="@style/Theme.BookMarket.ActionBar" />
        <activity android:name=".CartActivity" android:exported="false" android:label="장바구니" android:theme="@style/Theme.BookMarket.ActionBar" />
        <activity android:name=".BookActivity" android:exported="false" android:label="도서상세정보" android:theme="@style/Theme.BookMarket.ActionBar" />
        <activity android:name=".BooksActivity" android:exported="false" android:label="도서목록" android:theme="@style/Theme.BookMarket.ActionBar" />
        <activity android:name=".MenuActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".SplashActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
